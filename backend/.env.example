# Briefed API
PORT=8787

# Memory provider:
# - local  = offline demo memory (default for first run)
# - hindsight = use Hindsight Cloud (set HINDSIGHT_API_KEY)
MEMORY_PROVIDER=local

# Hindsight Cloud — required for the hackathon demo story
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=briefed-maya

# Groq (optional) — richer Meeting Brief prose; heuristic composer used if empty
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
