# Briefed API
PORT=8787

# REQUIRED — JWT signing secret for auth (min 16 chars). Never expose to the frontend.
# Must also be set in the Vercel project Environment Variables for production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional — override SQLite directory (defaults: backend/data locally, /tmp/briefed-data on Vercel)
# BRIEFED_DB_DIR=

# REQUIRED — Hindsight Cloud (long-term memory; no mock)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Fallback label for unauthenticated health checks only.
# Authenticated retain/recall use briefed-user-{userId} banks.
HINDSIGHT_BANK_ID=briefed-maya

# Strongly recommended — meeting brief prose from recalled memories
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
